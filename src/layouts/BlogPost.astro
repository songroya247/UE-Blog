---
const { frontmatter } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, 'https://blog.ultimateedge.info');
const postSlug = Astro.url.pathname.split('/').filter(Boolean).pop() || 'unknown';

// Safe date parser
const rawDate = frontmatter.date ? new Date(frontmatter.date) : new Date();
const displayDate = !isNaN(rawDate.getTime())
  ? rawDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : 'Recently updated';

// --- DYNAMIC AUTHOR LOGIC (DEFAULT SOLOMON OBAFEMI vs GUEST AUTHOR) ---
const isGuestPost = Boolean(frontmatter.author);
const authorName = frontmatter.author || "Solomon Obafemi";
const authorBio = frontmatter.authorBio || "Solomon Obafemi is an entrepreneur, educator, and content creator dedicated to making complex topics simple and practical. He publishes well-researched articles on education, technology, digital skills, and personal development to help readers make informed decisions.";

// Compute avatar initials (e.g. "Solomon Obafemi" -> "SO", "Grace Adebayo" -> "GA")
const authorAvatar = authorName
  .split(' ')
  .map(name => name[0])
  .join('')
  .toUpperCase()
  .slice(0, 2);

// Dynamic AI Disclosure
const aiDisclosure = frontmatter.aiDisclosure || 
  `Some articles are created with the assistance of AI as a research and writing tool. Every piece is reviewed, fact-checked, edited, and approved by ${authorName} before publication.`;

// --- AUTOMATED RELATED ARTICLES FOR INTERNAL SEO ---
const allPosts = await Astro.glob('../pages/posts/*.md');
const now = new Date();

// Filter: Only published posts, excluding current viewing page
const publishedPosts = allPosts.filter(p => 
  new Date(p.frontmatter.date) <= now && p.url !== Astro.url.pathname
);

// Find posts in same category first
const relatedCategoryPosts = publishedPosts
  .filter(p => p.frontmatter.category === frontmatter.category)
  .slice(0, 3);

// Fallback to latest published posts if category has less than 3
const finalRelatedPosts = relatedCategoryPosts.length >= 3
  ? relatedCategoryPosts
  : [...relatedCategoryPosts, ...publishedPosts.filter(p => !relatedCategoryPosts.includes(p))].slice(0, 3);

// --- STRUCTURED DATA: ARTICLE SCHEMA ---
const ogImageURL = 'https://blog.ultimateedge.info/og-default.jpg';
const isoDate = !isNaN(rawDate.getTime()) ? rawDate.toISOString() : new Date().toISOString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": frontmatter.title,
  "description": frontmatter.description || "Educational news, guides, and admission updates.",
  "image": [ogImageURL],
  "datePublished": isoDate,
  "dateModified": frontmatter.dateModified ? new Date(frontmatter.dateModified).toISOString() : isoDate,
  "author": {
    "@type": "Person",
    "name": authorName
  },
  "publisher": {
    "@type": "Organization",
    "name": "Ultimate Edge Education",
    "logo": {
      "@type": "ImageObject",
      "url": ogImageURL
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.toString()
  }
};

// --- STRUCTURED DATA: FAQPAGE SCHEMA (extracted from details.faq blocks, if present) ---
let faqSchema = null;
try {
  const compiled = await Astro.props.compiledContent?.();
  if (compiled) {
    const faqRegex = /<details class="faq">\s*<summary>([\s\S]*?)<\/summary>([\s\S]*?)<\/details>/g;
    const faqEntries = [];
    let match;
    while ((match = faqRegex.exec(compiled)) !== null) {
      const question = match[1].replace(/<[^>]+>/g, '').trim();
      const answer = match[2].replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
      if (question && answer) faqEntries.push({ question, answer });
    }
    if (faqEntries.length > 0) {
      faqSchema = {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqEntries.map(({ question, answer }) => ({
          "@type": "Question",
          "name": question,
          "acceptedAnswer": { "@type": "Answer", "text": answer }
        }))
      };
    }
  }
} catch (e) {
  faqSchema = null;
}

// --- STRUCTURED DATA: BREADCRUMBLIST SCHEMA ---
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://blog.ultimateedge.info/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": frontmatter.title,
      "item": canonicalURL.toString()
    }
  ]
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- Favicon -->
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="manifest" href="/site.webmanifest">

<!-- SEO Meta Tags -->
<title>{frontmatter.title}</title>
<meta name="description" content={frontmatter.description || "Educational news, guides, and admission updates."} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content="index, follow" />

<!-- OpenGraph / Social Media -->
<meta property="og:type" content="article" />
<meta property="og:title" content={frontmatter.title} />
<meta property="og:description" content={frontmatter.description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="Ultimate Edge Blog" />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={frontmatter.title} />
<meta name="twitter:description" content={frontmatter.description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Source+Sans+3:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">

<!-- Google Analytics (GA4) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-7W6R0EGRLC"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-7W6R0EGRLC');
</script>

<!-- Cloudflare Web Analytics -->
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "YOUR_CF_BEACON_TOKEN"}'></script>

<style is:inline>
  :root{
    --ink:#1f2420;
    --paper:#faf6ee;
    --paper-raised:#ffffff;
    --forest:#0b3d2e;
    --forest-dim:#12513d;
    --gold:#c9922e;
    --gold-soft:#f3e3c2;
    --rust:#a8452c;
    --rust-soft:#f7e2da;
    --line:#e2dccb;
    --muted:#5f6660;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Source Sans 3', sans-serif;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  h1,h2,h3,h4{
    font-family:'Fraunces', serif;
    font-weight:600;
    color:var(--forest);
    line-height:1.15;
    margin:0 0 .4em 0;
  }
  a{color:var(--forest-dim);}
  a:hover{color:var(--gold);}

  /* Reading progress bar */
  .progress-bar{
    position:fixed; top:0; left:0;
    height:3px;
    background:var(--gold);
    width:0%;
    z-index:1000;
    transition:width .1s ease-out;
  }

  /* Header Nav */
  header{
    background:var(--forest);
    padding:14px 24px;
    border-bottom:1px solid rgba(255,255,255,0.1);
  }
  .nav-inner{
    max-width:760px;
    margin:0 auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .logo{
    color:#fbf7ec;
    font-family:'Fraunces', serif;
    font-weight:700;
    text-decoration:none;
    font-size:1.1rem;
  }

  /* Hero Section */
  .hero{
    background:
      radial-gradient(1200px 500px at 85% -10%, rgba(201,146,46,0.16), transparent 60%),
      var(--forest);
    color:#f4efe1;
    padding:64px 24px 56px;
    position:relative;
    overflow:hidden;
  }
  .hero::after{
    content:"";
    position:absolute; inset:0;
    background-image:repeating-linear-gradient(90deg, rgba(244,239,225,0.045) 0 1px, transparent 1px 88px);
    pointer-events:none;
  }
  .hero-inner{max-width:760px; margin:0 auto; position:relative;}
  .eyebrow{
    font-family:'JetBrains Mono', monospace;
    font-size:.72rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--gold);
    margin-bottom:14px;
    display:flex; align-items:center; gap:10px;
  }
  .eyebrow::before{content:"●"; font-size:.6rem; color:#7fb89a;}
  .hero h1{
    color:#fbf7ec;
    font-size:clamp(2rem, 5vw, 3rem);
    max-width:18ch;
  }
  .hero p.lede{
    font-size:1.08rem;
    max-width:56ch;
    color:#d9d3bf;
    margin-top:14px;
  }
  .hero-meta{
    margin-top:28px;
    display:flex; gap:22px; flex-wrap:wrap;
    font-family:'JetBrains Mono', monospace;
    font-size:.75rem;
    color:#b9d8c6;
  }
  .hero-meta span b{color:#fbf7ec; font-weight:500;}

  /* Content Area */
  .wrap{max-width:760px; margin:0 auto; padding:0 24px;}

  /* Notice banner - Layering fix */
  .notice{
    position:relative;
    z-index:2;
    margin:-28px auto 40px;
    max-width:712px;
    background:var(--paper-raised);
    border:1px solid var(--line);
    border-left:4px solid var(--gold);
    border-radius:3px;
    padding:16px 20px;
    font-size:.92rem;
    box-shadow:0 8px 24px -18px rgba(11,61,46,0.4);
  }
  .notice b{color:var(--forest);}

  /* Table of contents */
  nav.toc{
    background:var(--paper-raised);
    border:1px solid var(--line);
    border-radius:6px;
    padding:20px 24px;
    margin:40px 0 48px;
  }
  nav.toc h2{font-size:1rem; text-transform:uppercase; letter-spacing:.06em; margin-bottom:12px;}
  nav.toc ol{margin:0; padding-left:1.1em; columns:2; column-gap:24px;}
  nav.toc li{margin-bottom:8px; font-size:.94rem; break-inside:avoid;}
  nav.toc a.active{color:var(--gold); font-weight:600;}
  @media (max-width:560px){ nav.toc ol{columns:1;} }

  section{margin-bottom:52px; scroll-margin-top:20px;}
  section h2{
    font-size:1.55rem;
    border-bottom:2px solid var(--gold-soft);
    padding-bottom:10px;
    margin-bottom:18px;
  }
  section h3{font-size:1.15rem; margin-top:26px;}

  blockquote.def{
    margin:18px 0;
    padding:18px 22px;
    background:var(--gold-soft);
    border-left:4px solid var(--gold);
    border-radius:3px;
    font-size:1rem;
  }
  blockquote.def b{color:var(--forest);}

  /* Callouts */
  .callout{
    padding:16px 20px;
    border-radius:4px;
    margin:20px 0;
    font-size:.94rem;
    border:1px solid var(--line);
  }
  .callout.tip{background:#eef2ec; border-left:4px solid var(--forest-dim);}
  .callout.warn{background:var(--rust-soft); border-left:4px solid var(--rust);}
  .callout strong.label{
    display:block; font-family:'JetBrains Mono', monospace;
    font-size:.72rem; letter-spacing:.08em; text-transform:uppercase;
    margin-bottom:6px; color:var(--rust);
  }
  .callout.tip strong.label{color:var(--forest-dim);}

  /* Content-embedded components: ASCII diagrams, info cards, static UI mockups, article sidebar */

  .diagram-container{
    display:block;
    overflow-x:auto;
    margin:20px 0;
    padding:16px 20px;
    background:var(--paper-raised);
    border:1px solid var(--line);
    border-radius:4px;
    font-family:'JetBrains Mono', monospace;
    font-size:.82rem;
    line-height:1.5;
    white-space:pre;
    color:var(--ink);
  }

  .meta{
    font-size:.85rem;
    color:var(--muted);
    margin-bottom:20px;
  }

  .correction-tag{
    display:inline-block;
    font-family:'JetBrains Mono', monospace;
    font-size:.62rem;
    font-weight:600;
    letter-spacing:.03em;
    text-transform:uppercase;
    background:var(--gold-soft);
    color:var(--rust);
    padding:3px 8px;
    border-radius:3px;
    vertical-align:middle;
    margin-left:8px;
  }

  .deadline-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));
    gap:14px;
    margin:20px 0;
  }
  .deadline-card{
    background:var(--paper-raised);
    border:1px solid var(--line);
    border-radius:4px;
    padding:16px 18px;
  }
  .deadline-card .date{
    font-family:'JetBrains Mono', monospace;
    font-size:1.05rem;
    font-weight:700;
    color:var(--forest);
    margin-bottom:4px;
  }
  .deadline-card .who{
    font-size:.88rem;
    color:var(--muted);
    line-height:1.4;
  }

  .disclaimer{
    font-size:.85rem;
    color:var(--muted);
    font-style:italic;
    border-top:1px solid var(--line);
    padding-top:14px;
    margin-top:24px;
  }

  .faq-item{
    padding:16px 0;
    border-bottom:1px solid var(--line);
  }
  .faq-item:last-child{border-bottom:none;}
  .faq-item h4{margin:0 0 8px;}
  .faq-item p{margin:0; color:var(--muted); font-size:.94rem;}

  /* Static, non-interactive UI mockups used for illustration only */
  .mock-form{
    background:var(--paper-raised);
    border:1px solid var(--line);
    border-radius:6px;
    padding:18px 20px;
    margin:20px 0;
  }
  .mock-form-title{
    font-family:'JetBrains Mono', monospace;
    font-size:.85rem;
    font-weight:600;
    border-bottom:1px solid var(--line);
    padding-bottom:10px;
    margin-bottom:12px;
  }
  .mock-form-row{
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:12px;
    padding:6px 0;
    font-size:.88rem;
  }
  .mock-form-label{color:var(--muted);}
  .mock-form-value{font-family:'JetBrains Mono', monospace;}
  .mock-form-actions{
    display:flex;
    gap:10px;
    margin-top:14px;
  }
  .mock-btn{
    display:inline-block;
    padding:8px 18px;
    border-radius:4px;
    border:1px solid var(--line);
    font-size:.85rem;
    background:var(--paper);
  }
  .mock-btn.primary{
    background:var(--forest);
    border-color:var(--forest);
    color:#fff;
  }

  /* Two-column article layout: main content + sidebar (TOC / related guides) */
  .main-container{
    display:grid;
    grid-template-columns:1fr 280px;
    gap:36px;
    align-items:start;
  }
  .main-container .content{min-width:0;}
  .sidebar{
    background:var(--paper-raised);
    border:1px solid var(--line);
    border-radius:4px;
    padding:20px;
    position:sticky;
    top:20px;
  }
  .sidebar h3{margin-top:0; font-size:1rem;}
  .sidebar ul{list-style:none; padding:0; margin:0;}
  .sidebar li{margin-bottom:8px; font-size:.88rem;}
  .sidebar a{color:var(--forest-dim); text-decoration:none;}
  .sidebar a:hover{color:var(--gold); text-decoration:underline;}

  .footer{
    font-size:.82rem;
    color:var(--muted);
    border-top:1px solid var(--line);
    padding-top:16px;
    margin-top:30px;
  }
  .footer a{color:var(--forest-dim);}

  @media (max-width:760px){
    .main-container{grid-template-columns:1fr;}
    .sidebar{position:static;}
  }

  /* Status rail */
  .status-rail{
    margin:24px 0 8px;
    display:flex;
    flex-direction:column;
    gap:0;
    border-left:2px solid var(--line);
    padding-left:0;
  }
  .status-step{
    position:relative;
    padding:16px 0 16px 28px;
    border-bottom:1px solid var(--line);
  }
  .status-step:last-child{border-bottom:none;}
  .status-step::before{
    content:"";
    position:absolute; left:-7px; top:22px;
    width:12px; height:12px;
    border-radius:50%;
    background:var(--paper);
    border:2px solid var(--forest-dim);
  }
  .status-step.final::before{background:var(--gold); border-color:var(--gold);}
  .status-step.negative::before{background:var(--rust); border-color:var(--rust);}
  .status-step .tag{
    font-family:'JetBrains Mono', monospace;
    font-size:.72rem;
    letter-spacing:.05em;
    color:var(--forest-dim);
    text-transform:uppercase;
  }
  .status-step h4{margin:4px 0 6px; font-family:'Fraunces',serif; font-size:1.08rem; color:var(--ink); font-weight:600;}
  .status-step p{margin:0; font-size:.93rem; color:var(--muted);}

  /* Mobile-friendly table horizontal scroll */
  table{
    display:block;
    width:100%;
    overflow-x:auto;
    white-space:nowrap;
    -webkit-overflow-scrolling:touch;
    border-collapse:collapse;
    margin:18px 0;
    font-size:.92rem;
  }
  thead th{background:var(--forest); color:#fbf7ec; text-align:left; padding:10px 14px; font-weight:600;}
  tbody td{padding:10px 14px; border-bottom:1px solid var(--line); vertical-align:top;}
  tbody tr:nth-child(even){background:#f2ede0;}

  /* Numbered steps */
  ol.steps{padding-left:0; list-style:none; counter-reset:step;}
  ol.steps li{
    counter-increment:step;
    padding:10px 0 10px 42px;
    position:relative;
    border-bottom:1px dashed var(--line);
  }
  ol.steps li:last-child{border-bottom:none;}
  ol.steps li::before{
    content:counter(step);
    position:absolute; left:0; top:8px;
    width:26px; height:26px;
    background:var(--forest);
    color:#fbf7ec;
    border-radius:50%;
    font-family:'JetBrains Mono', monospace;
    font-size:.8rem;
    display:flex; align-items:center; justify-content:center;
  }

  /* FAQ accordion */
  details.faq{
    background:var(--paper-raised);
    border:1px solid var(--line);
    border-radius:6px;
    padding:2px 20px;
    margin-bottom:10px;
  }
  details.faq summary{
    cursor:pointer;
    padding:14px 0;
    font-weight:600;
    color:var(--forest);
    list-style:none;
    display:flex; justify-content:space-between; align-items:center;
    gap:12px;
  }
  details.faq summary::-webkit-details-marker{display:none;}
  details.faq summary::after{
    content:"+";
    font-family:'JetBrains Mono', monospace;
    font-size:1.2rem; color:var(--gold); flex-shrink:0;
  }
  details.faq[open] summary::after{content:"–";}
  details.faq p{padding-bottom:16px; margin:0; color:var(--muted); font-size:.94rem;}

  /* Action plan closer */
  .action-plan{
    background:var(--forest);
    color:#f0ece0;
    border-radius:8px;
    padding:28px 26px;
    margin-top:8px;
  }
  .action-plan h3{color:#fbf7ec; margin-top:0;}
  .action-plan ul{padding-left:1.2em; margin:14px 0 0;}
  .action-plan li{margin-bottom:12px; font-size:.95rem; color:#d9d3bf;}
  .action-plan li b{color:#fbf7ec;}

  /* Engagement: Share, Like, Comments */
  .engagement{
    margin-top:32px;
    padding-top:24px;
    border-top:1px solid var(--line);
  }
  .engagement-bar{
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px;
    margin-bottom:32px;
  }
  .like-btn{
    display:flex; align-items:center; gap:9px;
    background:var(--paper-raised); border:1.5px solid var(--gold-soft);
    color:var(--forest); font-family:'Source Sans 3', sans-serif; font-weight:600; font-size:.92rem;
    padding:9px 20px; border-radius:999px; cursor:pointer; transition:border-color .15s ease, background .15s ease;
  }
  .like-btn:hover{border-color:var(--gold); background:var(--gold-soft);}
  .like-btn svg{width:19px; height:19px; flex-shrink:0; display:block;}
  .like-btn svg path{fill:none; stroke:var(--forest); stroke-width:2; stroke-linecap:round; stroke-linejoin:round; transition:fill .15s ease, stroke .15s ease;}
  .like-btn.liked{background:var(--rust-soft); border-color:var(--rust); color:var(--rust);}
  .like-btn.liked svg path{fill:var(--rust); stroke:var(--rust);}
  .like-btn.liked svg{animation:like-pop .35s ease;}
  @keyframes like-pop{
    0%{transform:scale(1);} 35%{transform:scale(1.3);} 100%{transform:scale(1);}
  }
  #likeCount{font-variant-numeric:tabular-nums;}

  .share-bar{display:flex; align-items:center; gap:8px; flex-wrap:wrap;}
  .share-label{font-size:.8rem; color:var(--muted); margin-right:4px; font-weight:600; letter-spacing:.02em;}
  .share-btn{
    display:inline-flex; align-items:center; justify-content:center;
    width:38px; height:38px; border-radius:50%; flex-shrink:0;
    background:var(--paper-raised); border:1.5px solid var(--line); color:var(--forest-dim);
    cursor:pointer; text-decoration:none; transition:all .15s ease; position:relative;
  }
  .share-btn svg{width:17px; height:17px; display:block;}
  .share-btn:hover{border-color:var(--forest-dim); background:var(--gold-soft); color:var(--forest); transform:translateY(-1px);}
  #shareWhatsapp:hover{border-color:#25D366; color:#25D366; background:#e9f9ef;}
  #shareX:hover{border-color:#0f1419; color:#0f1419; background:#eef0f1;}
  #shareFacebook:hover{border-color:#1877F2; color:#1877F2; background:#eaf2fe;}
  .share-btn.copied{border-color:var(--forest-dim); background:var(--forest-dim); color:#fff;}
  .share-btn.copied::after{
    content:"Copied!";
    position:absolute; bottom:calc(100% + 8px); left:50%; transform:translateX(-50%);
    background:var(--ink); color:#fff; font-size:.72rem; font-weight:600;
    padding:4px 9px; border-radius:4px; white-space:nowrap; pointer-events:none;
  }
  .share-btn.copied::before{
    content:""; position:absolute; bottom:calc(100% + 4px); left:50%; transform:translateX(-50%);
    border:4px solid transparent; border-top-color:var(--ink); pointer-events:none;
  }

  /* --- DYNAMIC RELATED ARTICLES STYLING --- */
  .related-articles-box {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 24px;
    margin: 30px 0 30px;
  }
  .related-articles-box h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.15rem;
    color: var(--forest);
    margin: 0 0 16px;
    border-bottom: 2px solid var(--gold-soft);
    padding-bottom: 8px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 14px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .related-card:hover {
    transform: translateY(-2px);
    border-color: var(--gold);
  }
  .related-category {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 6px;
  }
  .related-card h4 {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    margin: 0 0 10px;
  }
  .related-read {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--forest-dim);
    font-weight: 600;
  }

  /* About the Author & AI Disclosure Box */
  .author-box {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-left: 4px solid var(--forest);
    border-radius: 6px;
    padding: 24px;
    margin: 30px 0;
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }
  .author-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--forest);
    color: #fbf7ec;
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 1.15rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .author-content {
    flex-grow: 1;
  }
  .author-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--gold);
    display: block;
    margin-bottom: 2px;
  }
  .author-name {
    font-family: 'Fraunces', serif;
    font-size: 1.2rem;
    margin: 0 0 8px;
    color: var(--forest);
  }
  .author-bio-text {
    margin: 0 0 12px;
    font-size: .92rem;
    color: var(--ink);
    line-height: 1.55;
  }
  .ai-disclosure {
    margin: 0;
    padding-top: 12px;
    border-top: 1px dashed var(--line);
    font-size: .84rem;
    color: var(--muted);
    line-height: 1.5;
  }
  .ai-disclosure strong {
    color: var(--forest-dim);
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .author-box {
      flex-direction: column;
      gap: 12px;
    }
  }

  .comments-section{margin-top:8px;}
  .comments-heading{
    font-family:'Fraunces', serif; font-size:1.5rem; color:var(--forest); margin-bottom:18px;
  }
  .comment-form{
    display:flex; flex-direction:column; gap:10px; margin-bottom:32px;
    background:var(--paper-raised); border:1px solid var(--line); border-radius:10px; padding:18px;
  }
  .comment-form input[type="text"], .comment-form textarea{
    font-family:'Source Sans 3', sans-serif; font-size:.95rem; color:var(--ink);
    border:1.5px solid var(--line); border-radius:8px; padding:10px 12px;
    background:var(--paper); resize:vertical;
  }
  .comment-form input[type="text"]:focus, .comment-form textarea:focus{
    outline:none; border-color:var(--gold);
  }
  .comment-form textarea{min-height:90px;}
  .honeypot{position:absolute; left:-9999px; width:1px; height:1px; opacity:0;}
  .comment-submit{
    align-self:flex-start;
    font-family:'Source Sans 3', sans-serif; font-weight:600; font-size:.9rem;
    background:var(--forest); color:#fbf7ec; border:none; border-radius:999px;
    padding:10px 22px; cursor:pointer; transition:background .15s ease;
  }
  .comment-submit:hover{background:var(--forest-dim);}
  .comment-submit:disabled{opacity:.6; cursor:not-allowed;}
  .comment-status{font-size:.85rem; margin:0; min-height:1.2em;}
  .comment-status.error{color:var(--rust);}
  .comment-status.success{color:var(--forest-dim);}

  .comments-list{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:16px;}
  .comment-item{
    background:var(--paper-raised); border:1px solid var(--line); border-radius:10px; padding:16px 18px;
  }
  .comment-item .comment-meta{display:flex; align-items:baseline; gap:10px; margin-bottom:6px;}
  .comment-item .comment-name{font-family:'Fraunces', serif; font-weight:600; color:var(--forest); font-size:.98rem;}
  .comment-item .comment-date{font-size:.78rem; color:var(--muted);}
  .comment-item .comment-body{font-size:.94rem; color:var(--ink); line-height:1.55; white-space:pre-wrap;}
  .comments-loading, .comments-empty{color:var(--muted); font-size:.9rem; list-style:none;}

  /* Back to top */
  .back-to-top{
    position:fixed;
    bottom:24px; right:24px;
    width:44px; height:44px;
    border-radius:50%;
    background:var(--forest);
    color:#fbf7ec;
    border:none;
    font-size:1.2rem;
    cursor:pointer;
    opacity:0;
    pointer-events:none;
    transition:opacity .25s ease, background .2s ease;
    box-shadow:0 8px 20px -8px rgba(11,61,46,0.5);
    z-index:999;
  }
  .back-to-top.visible{opacity:1; pointer-events:auto;}
  .back-to-top:hover{background:var(--forest-dim);}

  footer{
    text-align:center;
    padding:36px 24px 60px;
    font-size:.82rem;
    color:var(--muted);
    border-top:1px solid var(--line);
    margin-top:40px;
  }
  .footer-links{
    display:flex; justify-content:center; align-items:center; gap:10px; flex-wrap:wrap;
    margin-bottom:14px; font-size:.85rem;
  }
  .footer-links a{color:var(--forest-dim); text-decoration:none;}
  .footer-links a:hover{color:var(--gold); text-decoration:underline;}
  .footer-links span{color:var(--line);}

  /* ===================================================================
     ARTICLE-BODY COMPONENTS
     Covers the recurring class names used across content-queue articles
     so any article using these no longer falls back to unstyled HTML.
     =================================================================== */

  /* Checklists */
  ul.checklist{list-style:none; margin:18px 0; padding:0; display:flex; flex-direction:column; gap:10px;}
  ul.checklist li{
    position:relative; padding:10px 14px 10px 40px;
    background:var(--paper-raised); border:1px solid var(--line); border-radius:6px;
  }
  ul.checklist li::before{
    content:"✓"; position:absolute; left:14px; top:10px;
    color:var(--forest-dim); font-weight:700;
  }
  ul.checklist li input[type="checkbox"]{margin-right:8px; accent-color:var(--forest-dim);}

  /* Tables: horizontal-scroll wrapper so wide tables don't break mobile layout */
  .table-container, .table-wrapper{
    overflow-x:auto; margin:22px 0; border:1px solid var(--line); border-radius:6px;
    -webkit-overflow-scrolling:touch;
  }
  .table-container table, .table-wrapper table{width:100%; border-collapse:collapse; font-size:.92rem;}
  .table-container th, .table-wrapper th{
    background:var(--forest); color:#fbf7ec; text-align:left; padding:10px 14px; white-space:nowrap;
  }
  .table-container td, .table-wrapper td{padding:10px 14px; border-top:1px solid var(--line);}

  /* FAQ blocks (question/answer div pairs, distinct from nav.toc's own faq-item) */
  .faq-question{
    font-family:'Fraunces', serif; font-weight:600; color:var(--forest);
    margin:20px 0 6px; font-size:1.05rem;
  }
  .faq-answer{color:var(--ink); margin:0 0 6px;}

  /* Alternate in-body table of contents (some articles use this instead of nav.toc) */
  .toc-container{
    background:var(--paper-raised); border:1px solid var(--line); border-radius:6px;
    padding:20px 24px; margin:40px 0 48px;
  }
  .toc-title{
    font-size:1rem; text-transform:uppercase; letter-spacing:.06em; margin-bottom:12px;
    font-family:'Fraunces', serif; color:var(--forest); font-weight:600;
  }
  .toc-list{margin:0; padding-left:1.1em;}
  .toc-list li{margin-bottom:8px; font-size:.94rem;}

  /* Key takeaways / summary boxes */
  .key-takeaways{
    background:var(--gold-soft); border-left:4px solid var(--gold); border-radius:3px;
    padding:18px 22px; margin:24px 0;
  }
  .key-takeaways h2, .key-takeaways h3, .key-takeaways h4{margin-top:0;}

  /* Breadcrumbs */
  .breadcrumbs{
    font-family:'JetBrains Mono', monospace; font-size:.78rem; color:var(--muted);
    margin:0 0 20px;
  }
  .breadcrumbs a{color:var(--forest-dim);}

  /* Math */
  .math-block, .math-formula{
    background:var(--paper-raised); border:1px solid var(--line); border-radius:6px;
    padding:16px 20px; margin:18px 0; font-family:'JetBrains Mono', monospace; font-size:.92rem;
    overflow-x:auto;
  }
  .math-expr{font-family:'JetBrains Mono', monospace; background:var(--gold-soft); padding:1px 5px; border-radius:3px;}

  /* Image placeholders / visual aids (used where a screenshot is described but not embedded) */
  .image-placeholder, .visual-aid{
    border:1.5px dashed var(--line); border-radius:6px; background:var(--paper-raised);
    color:var(--muted); font-size:.88rem; font-style:italic;
    padding:24px; margin:18px 0; text-align:center;
  }

  /* In-article images */
  section img, .article-body img{
    display:block;
    max-width:100%;
    height:auto;
    border:1px solid var(--line);
    border-radius:6px;
    margin:18px auto;
    box-shadow:0 8px 24px -18px rgba(11,61,46,0.4);
  }
  figure{margin:22px 0;}
  figure img{margin:0 auto 10px;}
  figcaption{
    text-align:center;
    font-size:.85rem;
    color:var(--muted);
    font-style:italic;
    line-height:1.5;
  }

  /* Generic callouts with modifier classes (tip / warning / info / summary / cta / syntax / rule) */
  .callout{
    border-left:4px solid var(--forest); background:var(--paper-raised); border:1px solid var(--line);
    border-radius:3px; padding:16px 20px; margin:20px 0; font-size:.95rem;
  }
  .callout.tip, .callout.callout-info, .callout.callout-summary, .callout.summary{
    border-left-color:var(--forest); 
  }
  .callout.callout-warning, .callout.warning-callout{
    border-left-color:var(--rust); background:var(--rust-soft);
  }
  .callout.callout-cta{border-left-color:var(--gold); background:var(--gold-soft);}
  .callout.callout-syntax, .callout.callout-rule{font-family:'JetBrains Mono', monospace; font-size:.88rem;}

  /* Badges (e.g. difficulty/demand indicators in tables) */
  .badge{
    display:inline-block; font-size:.72rem; font-weight:600; padding:2px 9px;
    border-radius:999px; font-family:'JetBrains Mono', monospace;
  }
  .badge-high{background:var(--rust-soft); color:var(--rust);}
  .badge-medium{background:var(--gold-soft); color:#8a6314;}
  .badge-low{background:#e3efe8; color:var(--forest-dim);}

  /* Numbered step / workflow blocks */
  .workflow-step, .step-content{margin-bottom:16px;}
  .step-number{
    display:inline-flex; align-items:center; justify-content:center;
    width:28px; height:28px; border-radius:50%; background:var(--forest); color:#fbf7ec;
    font-family:'JetBrains Mono', monospace; font-weight:600; font-size:.85rem; margin-bottom:8px;
  }

  /* Flowcharts / diagrams (simple stacked-step layout, no JS) */
  .flowchart-container, .chart-container{
    background:var(--paper-raised); border:1px solid var(--line); border-radius:6px;
    padding:20px; margin:20px 0; display:flex; flex-direction:column; gap:8px; align-items:flex-start;
  }
  .flowchart-step, .diagram-step{
    background:var(--gold-soft); border-radius:4px; padding:8px 14px; font-size:.92rem;
  }
  .diagram-arrow{color:var(--gold); font-weight:700; align-self:center;}

  /* Timeline strip */
  .timeline{
    background:var(--paper-raised); border:1px solid var(--line); border-radius:6px;
    padding:14px 18px; margin:20px 0; font-size:.9rem; color:var(--forest-dim);
  }

  /* Case studies / featured snippets */
  .case-study, .featured-snippet{
    background:var(--paper-raised); border:1px solid var(--line); border-left:4px solid var(--forest-dim);
    border-radius:3px; padding:16px 20px; margin:20px 0;
  }

  /* Trouble / troubleshooting cards */
  .trouble-card{
    background:var(--rust-soft); border:1px solid var(--line); border-left:4px solid var(--rust);
    border-radius:6px; padding:16px 20px; margin:16px 0;
  }

  /* Small text utilities */
  .text-center{text-align:center;}
  .sms-code{
    display:inline-block; font-family:'JetBrains Mono', monospace; background:var(--gold-soft);
    padding:6px 12px; border-radius:4px; font-size:.95rem;
  }
  .intro-lead{font-size:1.1rem; color:var(--forest-dim); margin:0 0 20px;}
  .last-updated{font-size:.82rem; color:var(--muted); font-family:'JetBrains Mono', monospace;}
  .meta-bar{
    display:flex; gap:16px; flex-wrap:wrap; font-size:.82rem; color:var(--muted);
    margin:0 0 20px; font-family:'JetBrains Mono', monospace;
  }

  /* Quick links / quick facts */
  .quick-links{display:flex; flex-wrap:wrap; gap:10px; margin:20px 0;}
  .quick-link-btn{
    background:var(--paper-raised); border:1px solid var(--line); border-radius:999px;
    padding:8px 16px; font-size:.85rem; text-decoration:none; color:var(--forest-dim);
  }
  .quick-link-btn:hover{border-color:var(--gold); color:var(--gold);}
  .quick-facts{
    background:var(--gold-soft); border-radius:6px; padding:16px 20px; margin:20px 0; font-size:.92rem;
  }

  /* Profile cards, mockups, time cards */
  .profile-card, .mockup-container{
    background:var(--paper-raised); border:1px solid var(--line); border-radius:6px;
    padding:18px 20px; margin:18px 0;
  }
  .time-cards{display:flex; gap:12px; flex-wrap:wrap; margin:18px 0;}
  .time-card{
    flex:1 1 140px; border:1px solid var(--line); border-radius:6px; padding:14px; font-size:.9rem;
  }

  /* In-body nav variants some articles include (distinct from the site nav in <header>) */
  .nav-index, .nav-links{
    font-family:'JetBrains Mono', monospace; font-size:.82rem; display:flex; gap:14px; flex-wrap:wrap;
    margin:16px 0;
  }
  .nav-index a, .nav-links a{color:var(--forest-dim);}

  /* Small titled labels inside callouts/boxes */
  .quick-summary{font-size:1.05rem; color:var(--forest-dim); margin:0 0 20px;}
  .warning-title, .mistakes-title, .resources-title{
    font-family:'Fraunces', serif; font-weight:600; color:var(--forest); margin-bottom:8px;
  }
  .warning-callout{
    background:var(--rust-soft); border-left:4px solid var(--rust); border-radius:3px;
    padding:16px 20px; margin:20px 0;
  }

  /* Practice-question blocks (MCQ with answer + explanation) */
  .question-title{font-family:'Fraunces', serif; font-weight:600; color:var(--forest); margin:20px 0 8px;}
  .options-list{list-style:none; margin:10px 0; padding:0; display:flex; flex-direction:column; gap:6px;}
  .options-list li{background:var(--paper-raised); border:1px solid var(--line); border-radius:6px; padding:8px 14px;}
  .correct-answer{color:var(--forest-dim); font-weight:600; margin:10px 0 6px;}
  .explanation{background:var(--gold-soft); border-radius:6px; padding:14px 18px; margin:0 0 20px; font-size:.92rem;}

  /* Generic page container some articles wrap themselves in */
  .container{max-width:100%;}
</style>
</head>
<body>

<div class="progress-bar" id="progressBar" aria-hidden="true"></div>

<header>
  <div class="nav-inner">
    <a href="/" class="logo">Ultimate Edge Blog</a>
    <a href="/" style="color:#b9d8c6; text-decoration:none; font-size:0.9rem;">← All Articles</a>
  </div>
</header>

<div class="hero">
  <div class="hero-inner">
    <div class="eyebrow">{frontmatter.category || "Guide"}</div>
    <h1>{frontmatter.title}</h1>
    <p class="lede">{frontmatter.description}</p>
    <div class="hero-meta">
      <span>Reviewed <b>{displayDate}</b></span>
      <span>Read time <b id="readingTime">–</b></span>
      {frontmatter.meta && frontmatter.meta.map((item) => (
        <span>{item.label} <b>{item.value}</b></span>
      ))}
    </div>
  </div>
</div>

<div class="wrap">
  <!-- Article Content Renders Here -->
  <slot />

  <!-- Engagement: Share & Like -->
  <div id="engagement" class="engagement" data-slug={postSlug} data-title={frontmatter.title}>
    <div class="engagement-bar">
      <button id="likeBtn" class="like-btn" type="button" aria-label="Like this article">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        <span id="likeCount">0</span> Likes
      </button>

      <div class="share-bar">
        <span class="share-label">Share</span>
        <a id="shareWhatsapp" class="share-btn" target="_blank" rel="noopener" aria-label="Share on WhatsApp" title="Share on WhatsApp">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 20l1.2-4A8 8 0 1 1 10 18.6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        </a>
        <a id="shareX" class="share-btn" target="_blank" rel="noopener" aria-label="Share on X" title="Share on X">
          <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="19" y1="5" x2="5" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </a>
        <a id="shareFacebook" class="share-btn" target="_blank" rel="noopener" aria-label="Share on Facebook" title="Share on Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><text x="12" y="17" font-size="15" font-weight="700" text-anchor="middle" fill="currentColor" font-family="Georgia, serif">f</text></svg>
        </a>
        <button id="copyLinkBtn" class="share-btn" type="button" aria-label="Copy link" title="Copy link">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- DYNAMIC RELATED GUIDES (INTERNAL SEO) -->
  {finalRelatedPosts.length > 0 && (
    <div class="related-articles-box">
      <h3>Related Admission Guides & Articles</h3>
      <div class="related-grid">
        {finalRelatedPosts.map(post => (
          <a href={post.url} class="related-card">
            <span class="related-category">{post.frontmatter.category}</span>
            <h4>{post.frontmatter.title}</h4>
            <span class="related-read">Read Guide →</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- About the Author & AI Disclosure -->
  <div class="author-box">
    <div class="author-avatar">{authorAvatar}</div>
    <div class="author-content">
      <span class="author-label">{isGuestPost ? "Guest Author" : "About the Author"}</span>
      <h4 class="author-name">{authorName}</h4>
      <p class="author-bio-text">{authorBio}</p>
      <p class="ai-disclosure">
        <strong>AI Disclosure:</strong> {aiDisclosure}
      </p>
    </div>
  </div>

  <!-- Comments Section (native, no signup required) -->
  <section class="comments-section" id="discussion">
    <h2 class="comments-heading">Comments</h2>

    <form id="commentForm" class="comment-form">
      <input type="text" id="commentName" name="name" placeholder="Your name" maxlength="60" required />
      <textarea id="commentText" name="comment" placeholder="Join the discussion — no signup needed" maxlength="1000" required></textarea>
      <!-- Honeypot field: hidden from real users via CSS, bots often fill it anyway -->
      <input type="text" id="commentWebsite" name="website" class="honeypot" tabindex="-1" autocomplete="off" />
      <button type="submit" class="comment-submit">Post Comment</button>
      <p id="commentStatus" class="comment-status"></p>
    </form>

    <ul id="commentsList" class="comments-list">
      <li class="comments-loading">Loading comments…</li>
    </ul>
  </section>
</div>

<footer>
  <div class="footer-links">
    <a href="/about">About</a>
    <span>·</span>
    <a href="/contact">Contact</a>
    <span>·</span>
    <a href="/privacy-policy">Privacy Policy</a>
    <span>·</span>
    <a href="/terms-of-service">Terms of Service</a>
  </div>
  © 2026 Ultimate Edge Blog — All rights reserved.
</footer>

<button id="backToTop" class="back-to-top" aria-label="Back to top">↑</button>

<script>
  // Reading progress bar
  const progressBar = document.getElementById('progressBar');
  function updateProgress() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    if (progressBar) progressBar.style.width = progress + '%';
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  // Estimated reading time
  const articleEl = document.querySelector('.wrap');
  const readingTimeEl = document.getElementById('readingTime');
  if (articleEl && readingTimeEl) {
    const wordCount = (articleEl.innerText || '').trim().split(/\s+/).filter(Boolean).length;
    readingTimeEl.textContent = Math.max(1, Math.round(wordCount / 225)) + ' min';
  }

  // Scrollspy for Table of Contents
  const tocLinks = document.querySelectorAll('nav.toc a[href^="#"]');
  const sections = document.querySelectorAll('section[id]');
  if (tocLinks.length && sections.length && 'IntersectionObserver' in window) {
    const tocMap = new Map();
    tocLinks.forEach((link) => tocMap.set(link.getAttribute('href').slice(1), link));
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const link = tocMap.get(entry.target.id);
        if (link) {
          tocLinks.forEach((l) => l.classList.remove('active'));
          link.classList.add('active');
        }
      });
    }, { rootMargin: '-15% 0px -70% 0px' });
    sections.forEach((section) => observer.observe(section));
  }

  // Back-to-top button
  const backToTop = document.getElementById('backToTop');
  if (backToTop) {
    window.addEventListener('scroll', () => {
      backToTop.classList.toggle('visible', window.scrollY > 600);
    }, { passive: true });
    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // --- Engagement: Share, Like, Comments ---
  // Same-origin API — no separate Worker or URL needed, this deploys
  // as part of the blog itself.
  const API_BASE = "/api";

  const engagementEl = document.getElementById('engagement');
  if (engagementEl) {
    const slug = engagementEl.dataset.slug;
    const pageTitle = engagementEl.dataset.title || document.title;
    const pageUrl = window.location.href;

    // --- Share buttons ---
    const shareText = encodeURIComponent(pageTitle);
    const shareUrl = encodeURIComponent(pageUrl);
    const wa = document.getElementById('shareWhatsapp');
    const x = document.getElementById('shareX');
    const fb = document.getElementById('shareFacebook');
    if (wa) wa.href = `https://wa.me/?text=${shareText}%20${shareUrl}`;
    if (x) x.href = `https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`;
    if (fb) fb.href = `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`;

    const copyBtn = document.getElementById('copyLinkBtn');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pageUrl);
          copyBtn.classList.add('copied');
          setTimeout(() => { copyBtn.classList.remove('copied'); }, 1800);
        } catch (e) {
          // Clipboard API unavailable — silently ignore
        }
      });
    }

    // --- Likes (real, shared count via D1 — not per-browser fake) ---
    const likeBtn = document.getElementById('likeBtn');
    const likeCountEl = document.getElementById('likeCount');
    const likedKey = `liked:${slug}`;

    async function loadLikes() {
      try {
        const res = await fetch(`${API_BASE}/likes?slug=${encodeURIComponent(slug)}`);
        const data = await res.json();
        likeCountEl.textContent = data.count ?? 0;
      } catch (e) {
        likeCountEl.textContent = '0';
      }
    }

    if (localStorage.getItem(likedKey)) {
      likeBtn.classList.add('liked');
    }

    if (likeBtn) {
      likeBtn.addEventListener('click', async () => {
        if (localStorage.getItem(likedKey)) return; // one like per browser
        likeBtn.disabled = true;
        try {
          const res = await fetch(`${API_BASE}/likes`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug }),
          });
          const data = await res.json();
          likeCountEl.textContent = data.count ?? 0;
          localStorage.setItem(likedKey, '1');
          likeBtn.classList.add('liked');
        } catch (e) {
          // network error — leave button enabled for retry
        }
        likeBtn.disabled = false;
      });
    }

    loadLikes();

    // --- Comments (native, no signup — real backend via D1) ---
    const commentsList = document.getElementById('commentsList');
    const commentForm = document.getElementById('commentForm');
    const commentStatus = document.getElementById('commentStatus');

    function renderComment(c) {
      const li = document.createElement('li');
      li.className = 'comment-item';
      const date = new Date(c.created_at + 'Z');
      const dateStr = isNaN(date.getTime()) ? '' : date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
      li.innerHTML = `
        <div class="comment-meta">
          <span class="comment-name"></span>
          <span class="comment-date">${dateStr}</span>
        </div>
        <p class="comment-body"></p>
      `;
      li.querySelector('.comment-name').textContent = c.name;
      li.querySelector('.comment-body').textContent = c.comment;
      return li;
    }

    async function loadComments() {
      try {
        const res = await fetch(`${API_BASE}/comments?slug=${encodeURIComponent(slug)}`);
        const data = await res.json();
        commentsList.innerHTML = '';
        if (!data.comments || data.comments.length === 0) {
          const li = document.createElement('li');
          li.className = 'comments-empty';
          li.textContent = 'No comments yet — be the first to share your thoughts.';
          commentsList.appendChild(li);
          return;
        }
        data.comments.forEach((c) => commentsList.appendChild(renderComment(c)));
      } catch (e) {
        commentsList.innerHTML = '<li class="comments-empty">Comments are temporarily unavailable.</li>';
      }
    }

    if (commentForm) {
      commentForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = document.getElementById('commentName').value.trim();
        const comment = document.getElementById('commentText').value.trim();
        const website = document.getElementById('commentWebsite').value; // honeypot
        const submitBtn = commentForm.querySelector('.comment-submit');

        if (!name || !comment) return;

        submitBtn.disabled = true;
        commentStatus.textContent = '';
        commentStatus.className = 'comment-status';

        try {
          const res = await fetch(`${API_BASE}/comments`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug, name, comment, website }),
          });
          const data = await res.json();
          if (data.comment) {
            const emptyMsg = commentsList.querySelector('.comments-empty');
            if (emptyMsg) emptyMsg.remove();
            commentsList.insertBefore(renderComment(data.comment), commentsList.firstChild);
          }
          commentForm.reset();
          commentStatus.textContent = 'Comment posted!';
          commentStatus.classList.add('success');
        } catch (e) {
          commentStatus.textContent = 'Something went wrong — please try again.';
          commentStatus.classList.add('error');
        }
        submitBtn.disabled = false;
      });
    }

    loadComments();
  }
</script>

</body>
</html>