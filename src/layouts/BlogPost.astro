---
const { frontmatter } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, 'https://blog.ultimateedge.info');

// Safe date parser
const rawDate = frontmatter.date ? new Date(frontmatter.date) : new Date();
const displayDate = !isNaN(rawDate.getTime())
  ? rawDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : 'Recently updated';

// --- DYNAMIC AUTHOR LOGIC (DEFAULT SOLOMON OBAFEMI vs GUEST AUTHOR) ---
const isGuestPost = Boolean(frontmatter.author);
const authorName = frontmatter.author || "Solomon Obafemi";
const authorBio = frontmatter.authorBio || "Solomon Obafemi is an entrepreneur, educator, and content creator dedicated to making complex topics simple and practical. He publishes well-researched articles on education, technology, digital skills, and personal development to help readers make informed decisions.";

// Compute avatar initials (e.g. "Solomon Obafemi" -> "SO", "Grace Adebayo" -> "GA")
const authorAvatar = authorName
  .split(' ')
  .map(name => name[0])
  .join('')
  .toUpperCase()
  .slice(0, 2);

// Dynamic AI Disclosure
const aiDisclosure = frontmatter.aiDisclosure || 
  `Some articles are created with the assistance of AI as a research and writing tool. Every piece is reviewed, fact-checked, edited, and approved by ${authorName} before publication.`;

// --- AUTOMATED RELATED ARTICLES FOR INTERNAL SEO ---
const allPosts = await Astro.glob('../pages/posts/*.md');
const now = new Date();

// Filter: Only published posts, excluding current viewing page
const publishedPosts = allPosts.filter(p => 
  new Date(p.frontmatter.date) <= now && p.url !== Astro.url.pathname
);

// Find posts in same category first
const relatedCategoryPosts = publishedPosts
  .filter(p => p.frontmatter.category === frontmatter.category)
  .slice(0, 3);

// Fallback to latest published posts if category has less than 3
const finalRelatedPosts = relatedCategoryPosts.length >= 3
  ? relatedCategoryPosts
  : [...relatedCategoryPosts, ...publishedPosts.filter(p => !relatedCategoryPosts.includes(p))].slice(0, 3);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- SEO Meta Tags -->
<title>{frontmatter.title}</title>
<meta name="description" content={frontmatter.description || "Educational news, guides, and admission updates."} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content="index, follow" />

<!-- OpenGraph / Social Media -->
<meta property="og:type" content="article" />
<meta property="og:title" content={frontmatter.title} />
<meta property="og:description" content={frontmatter.description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="Ultimate Edge Blog" />

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Source+Sans+3:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">

<style is:inline>
  :root{
    --ink:#1f2420;
    --paper:#faf6ee;
    --paper-raised:#ffffff;
    --forest:#0b3d2e;
    --forest-dim:#12513d;
    --gold:#c9922e;
    --gold-soft:#f3e3c2;
    --rust:#a8452c;
    --rust-soft:#f7e2da;
    --line:#e2dccb;
    --muted:#5f6660;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Source Sans 3', sans-serif;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  h1,h2,h3,h4{
    font-family:'Fraunces', serif;
    font-weight:600;
    color:var(--forest);
    line-height:1.15;
    margin:0 0 .4em 0;
  }
  a{color:var(--forest-dim);}
  a:hover{color:var(--gold);}

  /* Reading progress bar */
  .progress-bar{
    position:fixed; top:0; left:0;
    height:3px;
    background:var(--gold);
    width:0%;
    z-index:1000;
    transition:width .1s ease-out;
  }

  /* Header Nav */
  header{
    background:var(--forest);
    padding:14px 24px;
    border-bottom:1px solid rgba(255,255,255,0.1);
  }
  .nav-inner{
    max-width:760px;
    margin:0 auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .logo{
    color:#fbf7ec;
    font-family:'Fraunces', serif;
    font-weight:700;
    text-decoration:none;
    font-size:1.1rem;
  }

  /* Hero Section */
  .hero{
    background:
      radial-gradient(1200px 500px at 85% -10%, rgba(201,146,46,0.16), transparent 60%),
      var(--forest);
    color:#f4efe1;
    padding:64px 24px 56px;
    position:relative;
    overflow:hidden;
  }
  .hero::after{
    content:"";
    position:absolute; inset:0;
    background-image:repeating-linear-gradient(90deg, rgba(244,239,225,0.045) 0 1px, transparent 1px 88px);
    pointer-events:none;
  }
  .hero-inner{max-width:760px; margin:0 auto; position:relative;}
  .eyebrow{
    font-family:'JetBrains Mono', monospace;
    font-size:.72rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--gold);
    margin-bottom:14px;
    display:flex; align-items:center; gap:10px;
  }
  .eyebrow::before{content:"●"; font-size:.6rem; color:#7fb89a;}
  .hero h1{
    color:#fbf7ec;
    font-size:clamp(2rem, 5vw, 3rem);
    max-width:18ch;
  }
  .hero p.lede{
    font-size:1.08rem;
    max-width:56ch;
    color:#d9d3bf;
    margin-top:14px;
  }
  .hero-meta{
    margin-top:28px;
    display:flex; gap:22px; flex-wrap:wrap;
    font-family:'JetBrains Mono', monospace;
    font-size:.75rem;
    color:#b9d8c6;
  }
  .hero-meta span b{color:#fbf7ec; font-weight:500;}

  /* Content Area */
  .wrap{max-width:760px; margin:0 auto; padding:0 24px;}

  /* Notice banner - Layering fix */
  .notice{
    position:relative;
    z-index:2;
    margin:-28px auto 40px;
    max-width:712px;
    background:var(--paper-raised);
    border:1px solid var(--line);
    border-left:4px solid var(--gold);
    border-radius:3px;
    padding:16px 20px;
    font-size:.92rem;
    box-shadow:0 8px 24px -18px rgba(11,61,46,0.4);
  }
  .notice b{color:var(--forest);}

  /* Table of contents */
  nav.toc{
    background:var(--paper-raised);
    border:1px solid var(--line);
    border-radius:6px;
    padding:20px 24px;
    margin:40px 0 48px;
  }
  nav.toc h2{font-size:1rem; text-transform:uppercase; letter-spacing:.06em; margin-bottom:12px;}
  nav.toc ol{margin:0; padding-left:1.1em; columns:2; column-gap:24px;}
  nav.toc li{margin-bottom:8px; font-size:.94rem; break-inside:avoid;}
  nav.toc a.active{color:var(--gold); font-weight:600;}
  @media (max-width:560px){ nav.toc ol{columns:1;} }

  section{margin-bottom:52px; scroll-margin-top:20px;}
  section h2{
    font-size:1.55rem;
    border-bottom:2px solid var(--gold-soft);
    padding-bottom:10px;
    margin-bottom:18px;
  }
  section h3{font-size:1.15rem; margin-top:26px;}

  blockquote.def{
    margin:18px 0;
    padding:18px 22px;
    background:var(--gold-soft);
    border-left:4px solid var(--gold);
    border-radius:3px;
    font-size:1rem;
  }
  blockquote.def b{color:var(--forest);}

  /* Callouts */
  .callout{
    padding:16px 20px;
    border-radius:4px;
    margin:20px 0;
    font-size:.94rem;
    border:1px solid var(--line);
  }
  .callout.tip{background:#eef2ec; border-left:4px solid var(--forest-dim);}
  .callout.warn{background:var(--rust-soft); border-left:4px solid var(--rust);}
  .callout strong.label{
    display:block; font-family:'JetBrains Mono', monospace;
    font-size:.72rem; letter-spacing:.08em; text-transform:uppercase;
    margin-bottom:6px; color:var(--rust);
  }
  .callout.tip strong.label{color:var(--forest-dim);}

  /* Status rail */
  .status-rail{
    margin:24px 0 8px;
    display:flex;
    flex-direction:column;
    gap:0;
    border-left:2px solid var(--line);
    padding-left:0;
  }
  .status-step{
    position:relative;
    padding:16px 0 16px 28px;
    border-bottom:1px solid var(--line);
  }
  .status-step:last-child{border-bottom:none;}
  .status-step::before{
    content:"";
    position:absolute; left:-7px; top:22px;
    width:12px; height:12px;
    border-radius:50%;
    background:var(--paper);
    border:2px solid var(--forest-dim);
  }
  .status-step.final::before{background:var(--gold); border-color:var(--gold);}
  .status-step.negative::before{background:var(--rust); border-color:var(--rust);}
  .status-step .tag{
    font-family:'JetBrains Mono', monospace;
    font-size:.72rem;
    letter-spacing:.05em;
    color:var(--forest-dim);
    text-transform:uppercase;
  }
  .status-step h4{margin:4px 0 6px; font-family:'Fraunces',serif; font-size:1.08rem; color:var(--ink); font-weight:600;}
  .status-step p{margin:0; font-size:.93rem; color:var(--muted);}

  /* Mobile-friendly table horizontal scroll */
  table{
    display:block;
    width:100%;
    overflow-x:auto;
    white-space:nowrap;
    -webkit-overflow-scrolling:touch;
    border-collapse:collapse;
    margin:18px 0;
    font-size:.92rem;
  }
  thead th{background:var(--forest); color:#fbf7ec; text-align:left; padding:10px 14px; font-weight:600;}
  tbody td{padding:10px 14px; border-bottom:1px solid var(--line); vertical-align:top;}
  tbody tr:nth-child(even){background:#f2ede0;}

  /* Numbered steps */
  ol.steps{padding-left:0; list-style:none; counter-reset:step;}
  ol.steps li{
    counter-increment:step;
    padding:10px 0 10px 42px;
    position:relative;
    border-bottom:1px dashed var(--line);
  }
  ol.steps li:last-child{border-bottom:none;}
  ol.steps li::before{
    content:counter(step);
    position:absolute; left:0; top:8px;
    width:26px; height:26px;
    background:var(--forest);
    color:#fbf7ec;
    border-radius:50%;
    font-family:'JetBrains Mono', monospace;
    font-size:.8rem;
    display:flex; align-items:center; justify-content:center;
  }

  /* FAQ accordion */
  details.faq{
    background:var(--paper-raised);
    border:1px solid var(--line);
    border-radius:6px;
    padding:2px 20px;
    margin-bottom:10px;
  }
  details.faq summary{
    cursor:pointer;
    padding:14px 0;
    font-weight:600;
    color:var(--forest);
    list-style:none;
    display:flex; justify-content:space-between; align-items:center;
    gap:12px;
  }
  details.faq summary::-webkit-details-marker{display:none;}
  details.faq summary::after{
    content:"+";
    font-family:'JetBrains Mono', monospace;
    font-size:1.2rem; color:var(--gold); flex-shrink:0;
  }
  details.faq[open] summary::after{content:"–";}
  details.faq p{padding-bottom:16px; margin:0; color:var(--muted); font-size:.94rem;}

  /* Action plan closer */
  .action-plan{
    background:var(--forest);
    color:#f0ece0;
    border-radius:8px;
    padding:28px 26px;
    margin-top:8px;
  }
  .action-plan h3{color:#fbf7ec; margin-top:0;}
  .action-plan ul{padding-left:1.2em; margin:14px 0 0;}
  .action-plan li{margin-bottom:12px; font-size:.95rem; color:#d9d3bf;}
  .action-plan li b{color:#fbf7ec;}

  /* --- ARTICLE ENGAGEMENT: LIKES & SHARE BUTTONS --- */
  .article-engagement {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 22px 24px;
    margin: 40px 0 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .feedback-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 18px;
    border-bottom: 1px dashed var(--line);
  }
  .feedback-title {
    font-family: 'Fraunces', serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--forest);
  }
  .feedback-buttons {
    display: flex;
    gap: 10px;
  }
  .reaction-btn {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .reaction-btn:hover {
    border-color: var(--forest);
    background: #ffffff;
  }
  .reaction-btn.voted {
    background: var(--forest);
    color: #fbf7ec;
    border-color: var(--forest);
  }
  .badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    background: rgba(0, 0, 0, 0.08);
    padding: 2px 6px;
    border-radius: 10px;
  }
  .reaction-btn.voted .badge {
    background: var(--gold);
    color: var(--forest);
  }
  .feedback-thanks {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--forest-dim);
    font-weight: 600;
  }

  /* Share Box */
  .share-box {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .share-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
  }
  .share-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 10px;
  }
  .share-card {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
    padding: 10px 12px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .share-card:hover {
    transform: translateY(-2px);
    border-color: var(--gold);
  }
  .share-card.wa { background: #e7f7ed; color: #0d5c2e; border-color: #b8e6cf; }
  .share-card.fb { background: #e8f0fe; color: #1877f2; border-color: #c3d9fc; }
  .share-card.x  { background: #f1f3f4; color: #000000; border-color: #dadce0; }
  .share-card.tg { background: #e3f2fd; color: #0088cc; border-color: #bbdefb; }

  /* --- DYNAMIC RELATED ARTICLES STYLING --- */
  .related-articles-box {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 24px;
    margin: 30px 0 30px;
  }
  .related-articles-box h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.15rem;
    color: var(--forest);
    margin: 0 0 16px;
    border-bottom: 2px solid var(--gold-soft);
    padding-bottom: 8px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 14px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .related-card:hover {
    transform: translateY(-2px);
    border-color: var(--gold);
  }
  .related-category {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 6px;
  }
  .related-card h4 {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    margin: 0 0 10px;
  }
  .related-read {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--forest-dim);
    font-weight: 600;
  }

  /* About the Author & AI Disclosure Box */
  .author-box {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-left: 4px solid var(--forest);
    border-radius: 6px;
    padding: 24px;
    margin: 30px 0;
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }
  .author-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--forest);
    color: #fbf7ec;
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 1.15rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .author-content {
    flex-grow: 1;
  }
  .author-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--gold);
    display: block;
    margin-bottom: 2px;
  }
  .author-name {
    font-family: 'Fraunces', serif;
    font-size: 1.2rem;
    margin: 0 0 8px;
    color: var(--forest);
  }
  .author-bio-text {
    margin: 0 0 12px;
    font-size: .92rem;
    color: var(--ink);
    line-height: 1.55;
  }
  .ai-disclosure {
    margin: 0;
    padding-top: 12px;
    border-top: 1px dashed var(--line);
    font-size: .84rem;
    color: var(--muted);
    line-height: 1.5;
  }
  .ai-disclosure strong {
    color: var(--forest-dim);
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .author-box {
      flex-direction: column;
      gap: 12px;
    }
  }

  /* Comments Section */
  .comments-wrapper {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 28px 24px;
    margin: 30px 0 40px;
  }
  .comments-header h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.3rem;
    color: var(--forest);
    margin: 0 0 6px;
  }
  .comments-sub {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0 0 20px;
  }

  /* Back to top */
  .back-to-top{
    position:fixed;
    bottom:24px; right:24px;
    width:44px; height:44px;
    border-radius:50%;
    background:var(--forest);
    color:#fbf7ec;
    border:none;
    font-size:1.2rem;
    cursor:pointer;
    opacity:0;
    pointer-events:none;
    transition:opacity .25s ease, background .2s ease;
    box-shadow:0 8px 20px -8px rgba(11,61,46,0.5);
    z-index:999;
  }
  .back-to-top.visible{opacity:1; pointer-events:auto;}
  .back-to-top:hover{background:var(--forest-dim);}

  footer{
    text-align:center;
    padding:36px 24px 60px;
    font-size:.82rem;
    color:var(--muted);
    border-top:1px solid var(--line);
    margin-top:40px;
  }
</style>
</head>
<body>

<div class="progress-bar" id="progressBar" aria-hidden="true"></div>

<header>
  <div class="nav-inner">
    <a href="/" class="logo">Ultimate Edge Blog</a>
    <a href="/" style="color:#b9d8c6; text-decoration:none; font-size:0.9rem;">← All Articles</a>
  </div>
</header>

<div class="hero">
  <div class="hero-inner">
    <div class="eyebrow">{frontmatter.category || "Guide"}</div>
    <h1>{frontmatter.title}</h1>
    <p class="lede">{frontmatter.description}</p>
    <div class="hero-meta">
      <span>Reviewed <b>{displayDate}</b></span>
      <span>Read time <b id="readingTime">–</b></span>
      {frontmatter.meta && frontmatter.meta.map((item) => (
        <span>{item.label} <b>{item.value}</b></span>
      ))}
    </div>
  </div>
</div>

<div class="wrap">
  <!-- Article Content Renders Here -->
  <slot />

  <!-- ARTICLE ENGAGEMENT: LIKES & SHARE BUTTONS -->
  <div class="article-engagement">
    
    <!-- Like / Reaction Widget -->
    <div class="feedback-box">
      <span class="feedback-title">Was this guide helpful?</span>
      <div class="feedback-buttons">
        <button id="likeBtn" class="reaction-btn like-btn" aria-label="Helpful">
          👍 <span id="likeText">Useful</span> <span id="likeCount" class="badge">12</span>
        </button>
        <button id="dislikeBtn" class="reaction-btn dislike-btn" aria-label="Not Helpful">
          👎 Needs Update
        </button>
      </div>
      <span id="feedbackThanks" class="feedback-thanks" style="display:none;">
        Thanks for your feedback!
      </span>
    </div>

    <!-- Social Share Bar (Tailored for Nigerian Audience) -->
    <div class="share-box">
      <span class="share-title">SHARE THIS GUIDE</span>
      <div class="share-grid">
        <a id="shareWA" href="#" target="_blank" rel="noopener" class="share-card wa">
          <span>💬</span> WhatsApp
        </a>
        <a id="shareFB" href="#" target="_blank" rel="noopener" class="share-card fb">
          <span>📘</span> Facebook
        </a>
        <a id="shareX" href="#" target="_blank" rel="noopener" class="share-card x">
          <span>🖤</span> X / Twitter
        </a>
        <a id="shareTG" href="#" target="_blank" rel="noopener" class="share-card tg">
          <span>✈️</span> Telegram
        </a>
        <button id="copyLinkBtn" class="share-card copy">
          <span>📋</span> <span id="copyText">Copy Link</span>
        </button>
      </div>
    </div>

  </div>

  <!-- DYNAMIC RELATED GUIDES (INTERNAL SEO) -->
  {finalRelatedPosts.length > 0 && (
    <div class="related-articles-box">
      <h3>Related Admission Guides & Articles</h3>
      <div class="related-grid">
        {finalRelatedPosts.map(post => (
          <a href={post.url} class="related-card">
            <span class="related-category">{post.frontmatter.category}</span>
            <h4>{post.frontmatter.title}</h4>
            <span class="related-read">Read Guide →</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- About the Author & AI Disclosure -->
  <div class="author-box">
    <div class="author-avatar">{authorAvatar}</div>
    <div class="author-content">
      <span class="author-label">{isGuestPost ? "Guest Author" : "About the Author"}</span>
