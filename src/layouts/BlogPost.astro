</div>

<footer>
  © 2026 Ultimate Edge Blog — All rights reserved.
</footer>

<button id="backToTop" class="back-to-top" aria-label="Back to top">↑</button>

<script>
  // Reading progress bar
  const progressBar = document.getElementById('progressBar');
  function updateProgress() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    if (progressBar) progressBar.style.width = progress + '%';
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  // Estimated reading time
  const articleEl = document.querySelector('.wrap');
  const readingTimeEl = document.getElementById('readingTime');
  if (articleEl && readingTimeEl) {
    const wordCount = (articleEl.innerText || '').trim().split(/\s+/).filter(Boolean).length;
    readingTimeEl.textContent = Math.max(1, Math.round(wordCount / 225)) + ' min';
  }

  // Scrollspy for Table of Contents
  const tocLinks = document.querySelectorAll('nav.toc a[href^="#"]');
  const sections = document.querySelectorAll('section[id]');
  if (tocLinks.length && sections.length && 'IntersectionObserver' in window) {
    const tocMap = new Map();
    tocLinks.forEach((link) => tocMap.set(link.getAttribute('href').slice(1), link));
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const link = tocMap.get(entry.target.id);
        if (link) {
          tocLinks.forEach((l) => l.classList.remove('active'));
          link.classList.add('active');
        }
      });
    }, { rootMargin: '-15% 0px -70% 0px' });
    sections.forEach((section) => observer.observe(section));
  }

  // Back-to-top button
  const backToTop = document.getElementById('backToTop');
  if (backToTop) {
    window.addEventListener('scroll', () => {
      backToTop.classList.toggle('visible', window.scrollY > 600);
    }, { passive: true });
    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // DYNAMIC SHARE BUTTONS
  const pageUrl = window.location.href;
  const pageTitle = document.title;

  const waBtn = document.getElementById('shareWA');
  const fbBtn = document.getElementById('shareFB');
  const xBtn  = document.getElementById('shareX');
  const tgBtn = document.getElementById('shareTG');
  const copyBtn = document.getElementById('copyLinkBtn');
  const copyText = document.getElementById('copyText');

  if (waBtn) waBtn.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(pageTitle + ' - ' + pageUrl)}`;
  if (fbBtn) fbBtn.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`;
  if (xBtn)  xBtn.href  = `https://twitter.com/intent/tweet?text=${encodeURIComponent(pageTitle)}&url=${encodeURIComponent(pageUrl)}`;
  if (tgBtn) tgBtn.href = `https://t.me/share/url?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(pageTitle)}`;

  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(pageUrl).then(() => {
        if (copyText) copyText.textContent = "Copied! ✓";
        setTimeout(() => { if (copyText) copyText.textContent = "Copy Link"; }, 2000);
      });
    });
  }

  // LIKE / REACTION WIDGET (LocalStorage)
  const likeBtn = document.getElementById('likeBtn');
  const dislikeBtn = document.getElementById('dislikeBtn');
  const likeCountEl = document.getElementById('likeCount');
  const thanksEl = document.getElementById('feedbackThanks');

  const postKey = 'voted_' + window.location.pathname;
  let currentLikes = parseInt(localStorage.getItem('likes_' + window.location.pathname) || '14', 10);

  if (likeCountEl) likeCountEl.textContent = currentLikes;

  if (localStorage.getItem(postKey)) {
    if (likeBtn) likeBtn.classList.add('voted');
    if (dislikeBtn) dislikeBtn.disabled = true;
  }

  if (likeBtn && !localStorage.getItem(postKey)) {
    likeBtn.addEventListener('click', () => {
      currentLikes += 1;
      localStorage.setItem('likes_' + window.location.pathname, currentLikes);
      localStorage.setItem(postKey, 'true');
      
      if (likeCountEl) likeCountEl.textContent = currentLikes;
      likeBtn.classList.add('voted');
      if (dislikeBtn) dislikeBtn.disabled = true;
      if (thanksEl) thanksEl.style.display = 'inline';
    });
  }

  if (dislikeBtn && !localStorage.getItem(postKey)) {
    dislikeBtn.addEventListener('click', () => {
      localStorage.setItem(postKey, 'true');
      dislikeBtn.classList.add('voted');
      if (likeBtn) likeBtn.disabled = true;
      if (thanksEl) thanksEl.style.display = 'inline';
    });
  }
</script>

</body>
</html>