      <h3>Questions & Discussion</h3>
      <p>Have questions about your admission, cut-off mark, or screening? Leave a comment below.</p>
    </div>

    <!-- Giscus Comment Embed Container -->
    <div class="giscus-box">
      <script 
        src="https://giscus.app/client.js"
        data-repo="songroya247/UE-Blog"
        data-repo-id="R_kgDOTjhrhw"
        data-category="General"
        data-category-id="DIC_kwDOTjhrh84DCLsO"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="light"
        data-lang="en"
        crossorigin="anonymous"
        async>
